# Lab box: master pinned to 96 CPUs to match the prod master shape. Run from the repo root:
#   build/latest/bin/master-heartbeat-bench --flagfile=src/yb/tools/master_heartbeat_bench_flags/bench-linux.flags \
#     --num_tservers=100 --csv_path=hb-bench-100x100.csv
--master_bin=build/latest/bin/yb-master
--tserver_bin=build/latest/bin/yb-tserver
--data_dir=/tmp/hb-bench
--tablet_replicas_per_tserver=100
--send_lease_refreshes=false
--master_cpus=0-95
--master_flags=--flagfile=src/yb/tools/master_heartbeat_bench_flags/master.flags,--num_reactor_threads=192
--tserver_flags=--flagfile=src/yb/tools/master_heartbeat_bench_flags/tserver.flags
