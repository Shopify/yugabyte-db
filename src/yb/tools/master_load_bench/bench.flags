# Run from the repo root:
#   build/latest/bin/master-load-bench --flagfile=src/yb/tools/master_load_bench/bench.flags \
#     --num_tservers=100 --input-dir=/tmp/mlb-prep --csv_path=mlb.csv
# /tmp/mlb-prep is prepare.py's --output-dir.
# Restart on the same data: add --resume (and drop --input-dir).
--master_bin=build/latest/bin/yb-master
--tserver_bin=build/latest/bin/yb-tserver
--data_dir=/tmp/mlb
# Periodic tserver->master RPCs at production cadence (tserver defaults).
--heartbeat_interval_ms=1000
--master_flags=--flagfile=src/yb/tools/master_load_bench/master.flags
--tserver_flags=--flagfile=src/yb/tools/master_load_bench/tserver.flags
