--allowed_preview_flags_csv=ysql_enable_concurrent_ddl
--ysql_enable_concurrent_ddl=false
--enable_object_locking_for_table_locks=false
--ysql_yb_ddl_transaction_block_enabled=false
--ysql_yb_enable_ddl_savepoint_support=false
--ysql_yb_enable_new_relation_fastpath_write_in_txn_blocks=false
--ysql_beta_features=true
# Production's catalog preload list: every new backend reads the full catalog itself and the
# internal relcache-init connection is never used.
--ysql_catalog_preload_additional_tables=true
--ysql_catalog_preload_additional_table_list=pg_statistic,pg_amop,pg_operator,pg_namespace,pg_auth_members,pg_range
